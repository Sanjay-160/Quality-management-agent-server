# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
app/**/__pycache__/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & sensitive credentials (preserve example)
.env
.env.*
!.env.example
runtime_config.json

# Distribution / packaging
dist/
build/
*.egg-info/
.installed.cfg
*.egg

# Database & SQLite files
*.db
*.sqlite
*.sqlite3

# Logs & debugging
*.log
logs/

