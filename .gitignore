.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary & scratch files
tmp/
temp/
*.tmp
